#include <Arduino.h>
#define RAIN_AO_PIN 32
#define RAIN_DO_PIN 25
#define LIGHT_AO_PIN 33

void setup()
{
  Serial.begin(115200);
  delay(1000);

  pinMode(RAIN_DO_PIN, INPUT);
  analogReadResolution(12); // ESP32 ADC: 0 - 4095

  Serial.println("=== Rain + Light Sensor Test ===");
  Serial.println("Rain AO  -> GPIO32");
  Serial.println("Rain DO  -> GPIO25");
  Serial.println("Light AO -> GPIO33");
}

void loop()
{
  int rainRaw = analogRead(RAIN_AO_PIN);
  int rainDo = digitalRead(RAIN_DO_PIN);
  int lightRaw = analogRead(LIGHT_AO_PIN);

  Serial.print("Rain raw = ");
  Serial.print(rainRaw);

  Serial.print(" | Rain DO = ");
  Serial.print(rainDo);

  Serial.print(" | Light raw = ");
  Serial.print(lightRaw);

  Serial.print(" | Rain status = ");
  if (rainRaw < 2000)
  {
    Serial.print("CO MUA / BI UOT");
  }
  else
  {
    Serial.print("KHONG MUA / KHO");
  }

  Serial.print(" | Light status = ");
  if (lightRaw < 1500)
  {
    Serial.println("SANG");
  }
  else if (lightRaw < 3000)
  {
    Serial.println("TRUNG BINH");
  }
  else
  {
    Serial.println("TOI");
  }

  delay(1000);
}